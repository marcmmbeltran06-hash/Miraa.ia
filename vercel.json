{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/prepare_mira_home.mjs && pnpm --filter @autowp/web run build",
  "outputDirectory": "packages/web/dist",
  "routes": [
    { "src": "/", "dest": "/mira-home.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
